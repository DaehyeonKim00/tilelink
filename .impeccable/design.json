  "narrative": {
    "northStar": "The Trade Counter",
    "overview": "Tile Link's site works like a well-run trade counter: everything is labelled clearly, the product is in front of you, and a person is always one step away. It is a catalogue, not a shop. The look is the original navy and blue on white with a faint construction grid as the page ground, large legible type and standard controls.",
    "keyCharacteristics": [
      "Navy header and contact band, white working surfaces, blue only for actions and state.",
      "Large type (18px base, adjustable to 21px and 24px) in one legibility-first face.",
      "Solid surfaces with 1px slate borders; depth only as a soft hover shadow.",
      "Contact is present in the header, hero, a fixed Call button and the footer."
    ],
    "rules": [
      {
        "name": "The Blue Family Rule",
        "body": "The brand colour is the original navy and blue. No new brand colours.",
        "section": "colors"
      },
      {
        "name": "The Readable Blue Rule",
        "body": "Joint Blue (#3182ce) never carries small text.",
        "section": "colors"
      },
      {
        "name": "The Readability Rule",
        "body": "Nothing below 0.9rem, no light weights, and the layout holds at the largest text size.",
        "section": "typography"
      },
      {
        "name": "The Solid Surface Rule",
        "body": "Text never sits directly on the grid ground.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the navy and blue family as the only brand colours.",
      "Do keep body text at 18px or larger with 4.5:1 contrast or better.",
      "Do make every tappable control at least 48px tall.",
      "Do keep contact details in the footer band and show missing ones as clear placeholders."
    ],
    "donts": [
      "Don't add a cart, prices, customer login or promotions.",
      "Don't state delivery area, cut-off time or cost until the owner provides them; same-day fast delivery is the confirmed claim.",
      "Don't use gradients, glass, emoji icons or small labels above headings.",
      "Don't invent popularity, reviews or stock claims."
    ]
  }
